# Copy this file to .env and fill in real values. .env is gitignored.
#
# Values are injected at BUILD time — .env is never bundled into the APK:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env

# Firebase (from your Firebase project settings)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

FIREBASE_APP_ID_WEB=your_web_app_id
FIREBASE_APP_ID_ANDROID=your_android_app_id
FIREBASE_APP_ID_IOS=your_ios_app_id
FIREBASE_APP_ID_MACOS=your_macos_app_id
FIREBASE_APP_ID_WINDOWS=your_windows_app_id

# Hack Club AI key for the assistant tab — get one at https://ai.hackclub.com/dashboard
HACKCLUB_API_KEY=replace_with_your_hackclub_api_key

# Hack Club Search key for Hey Neko voice "results" queries (Brave pass-through
# at https://search.hackclub.com). Optional — without it, results-style voice
# questions just fall back to a plain spoken answer instead of a tappable list.
SEARCH_API_KEY=replace_with_your_hackclub_search_key
# SEARCH_BASE_URL=https://search.hackclub.com
# Web search is OPTIONAL. Without any key, results-style queries ("best…",
# "recommend…") just offer a one-tap Google search that opens in the browser —
# no key, always works. Add a key here only if you want a polished in-app result
# list. Hack Club's key currently 422s (their upstream Brave token is down); for
# a real in-app list, get a free key at https://brave.com/search/api and point
# straight at Brave — the service auto-switches to Brave's X-Subscription-Token.
# SEARCH_BASE_URL=https://api.search.brave.com

# Optional AI overrides — sensible defaults are baked in; uncomment only to override.
# AI_BASE_URL defaults to the Hack Club OpenAI-compatible proxy.
# AI_MODEL defaults to google/gemini-3-flash-preview (the app's chosen model).
# AI_API_KEY is an alternate to HACKCLUB_API_KEY for a different OpenAI-compatible backend.
# AI_BASE_URL=https://ai.hackclub.com/proxy/v1
# AI_MODEL=google/gemini-3-flash-preview
# AI_API_KEY=
